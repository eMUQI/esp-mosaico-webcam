+bool uvc_transport_busy(uint_fast8_t ctl_idx, uint_fast8_t stm_idx) {
+  videod_streaming_interface_t *stm = _get_instance_streaming(ctl_idx, stm_idx);
+  return stm && stm->buffer;
+}
+
+void uvc_transport_abort(uint_fast8_t ctl_idx, uint_fast8_t stm_idx) {
+  videod_streaming_interface_t *stm = _get_instance_streaming(ctl_idx, stm_idx);
+  if (!stm) return;
+  if (stm->desc.ep[0]) {
+    uint8_t const *desc = _videod_itf[stm->index_vc].beg;
+    uint8_t ep_addr = _desc_ep_addr(desc + stm->desc.ep[0]);
+    usbd_edpt_stall(0, ep_addr);
+    usbd_edpt_clear_stall(0, ep_addr);
+    usbd_edpt_release(0, ep_addr);
+  }
+  stm->buffer = NULL;
+  stm->bufsize = 0;
+  stm->offset = 0;
+}
